<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<RootNamespace>Module</RootNamespace>
		<AssemblyName>$(MSBuildProjectName.Replace(".", ""))_amxx</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<AmxxModuleName>WeaponExtend</AmxxModuleName>
		<AmxxModuleVersion>2.2</AmxxModuleVersion>
		<AmxxModuleAuthor>Izayoi Fly (原版 Pawn) / GoldSrcMod.Net C# 移植</AmxxModuleAuthor>
		<AmxxModuleUrl></AmxxModuleUrl>
		<AmxxModuleLogTag>WPNEXT</AmxxModuleLogTag>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Shared\EngineStrings.cs" Link="EngineStrings.cs" />
		<Compile Include="..\Shared\EngineResources.cs" Link="EngineResources.cs" />
		<Compile Include="..\Shared\HookResult.cs" Link="HookResult.cs" />
		<Compile Include="..\Shared\PawnMath.cs" Link="PawnMath.cs" />
		<PackageReference Include="Amxmodx.Framework" Version="1.1.1-alpha.0.4" />
		<PackageReference Include="Amxmodx.SourceGenerator" Version="1.1.1-alpha.0.4" PrivateAssets="all" />
	</ItemGroup>

</Project>
