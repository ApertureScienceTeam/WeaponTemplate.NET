<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<RootNamespace>Module</RootNamespace>
		<AssemblyName>$(MSBuildProjectName.Replace(".", ""))_amxx</AssemblyName>
	</PropertyGroup>

	<PropertyGroup>
		<AmxxModuleName>WeaponTemplate</AmxxModuleName>
		<AmxxModuleVersion>1.38</AmxxModuleVersion>
		<AmxxModuleAuthor>Fly (原版 Pawn) / GoldSrcMod.Net C# 移植</AmxxModuleAuthor>
		<AmxxModuleUrl></AmxxModuleUrl>
		<AmxxModuleLogTag>WPN</AmxxModuleLogTag>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Amxmodx.Framework" Version="1.1.0" />
		<PackageReference Include="Amxmodx.SourceGenerator" Version="1.1.0" PrivateAssets="all" />
	</ItemGroup>

</Project>
