<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../../Game.targets" />
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>true</PublishAot>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<IsPackable>false</IsPackable>
		<RootNamespace>Module</RootNamespace>
		<AssemblyName>$(MSBuildProjectName.Replace(".", ""))_amxx</AssemblyName>
		<NativeAot>true</NativeAot>
	</PropertyGroup>

	<PropertyGroup>
		<AmxxModuleName>WeaponTemplate</AmxxModuleName>
		<AmxxModuleVersion>1.38</AmxxModuleVersion>
		<AmxxModuleAuthor>Fly (原版 Pawn) / GoldSrcMod.Net C# 移植</AmxxModuleAuthor>
		<AmxxModuleUrl></AmxxModuleUrl>
		<AmxxModuleLogTag>WPN</AmxxModuleLogTag>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="..\Shared\EngineStrings.cs" Link="EngineStrings.cs" />
		<Compile Include="..\Shared\EngineResources.cs" Link="EngineResources.cs" />
		<Compile Include="..\Shared\HookResult.cs" Link="HookResult.cs" />
		<Compile Include="..\Shared\PawnMath.cs" Link="PawnMath.cs" />
		<PackageReference Include="Amxmodx.Framework" Version="1.1.1-alpha.0.4" />
		<PackageReference Include="Amxmodx.SourceGenerator" Version="1.1.1-alpha.0.4" PrivateAssets="all" />
	</ItemGroup>



	<PropertyGroup>
		<OutputType>Library</OutputType>
		<RuntimeIdentifier>win-x86</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishAot>true</PublishAot>
	</PropertyGroup>
	
	<Target Name="AfterBuildPublish" AfterTargets="Build" Condition="'$(AfterBuildPublishRunning)' != 'true' ">
		<MSBuild Projects="$(ProjectPath)" Targets="Publish" Properties="Configuration=$(Configuration);AfterBuildPublishRunning=true" />
	</Target>

	<!-- 发布产物落地：插件本体进 metahook/plugins，Skia 系原生库进游戏根目录（引擎加载路径） -->
	<Target Name="CopyPublishedFilesToGame" AfterTargets="Publish">
		<Copy SourceFiles="$(OutDir)$(AssemblyName.Replace('_amxx', ''))_bridge.amxx" DestinationFolder="$(PluginDir)" />
		<Copy SourceFiles="$(PublishDir)/$(AssemblyName).dll" DestinationFolder="$(ModuleDir)" />
	</Target>
</Project>
